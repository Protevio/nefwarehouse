# Written by bootstrap.sh with a generated password. This file is an example;
# the real one is infra/env/wms.env, which is not in git and never should be.

# postgres is the service name on Docker's private network, not a hostname you
# can reach from anywhere else.
DATABASE_URL="postgresql://namdhari:REPLACE_ME@postgres:5432/namdhari?schema=public"

# Sending paperwork and quality reports. Leave blank and the send buttons say
# so plainly rather than failing quietly.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Namdhari's Euro Fresh <warehouse@namdharithaifresh.com>"
