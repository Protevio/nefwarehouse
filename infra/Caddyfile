# Caddy gets the certificates by itself and renews them without being asked.
# Keep the Cloudflare proxy OFF (grey cloud) until the first certificate is
# issued: an orange-clouded record answers the ACME challenge itself and Caddy
# never sees it, which fails in a way that looks like the server is down.
#
# No ACME email here on purpose: this repository is public, and an address in a
# public file is an address that gets scraped. Caddy issues and renews fine
# without one.

nefwarehouse.com, www.nefwarehouse.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	# ── robots.txt ──────────────────────────────────────────────────────────
	#
	# The welcome page with its two doors is gone (October 2026): the address
	# goes straight to the warehouse system, which sends you to the sign-in
	# page or, if this device is already signed in, straight in (Thailand's
	# partner accounts to their own page). Only robots.txt is still served
	# from here, so search engines keep out.
	@site path /robots.txt
	handle @site {
		root * /srv/site
		file_server
	}

	# ── the warehouse system ────────────────────────────────────────────────
	#
	# Everything else, the root included.
	handle {
		reverse_proxy wms:3000 {
			# Caddy terminates TLS, so the app would otherwise see plain http
			# and refuse to set a Secure cookie — sign-in would appear to work
			# and bounce straight back to the form.
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}

		# Inspection photographs. The default cap is far below a phone camera.
		request_body {
			max_size 25MB
		}
	}
}

# ── the customer shop ─────────────────────────────────────────────────────
#
# Air orders for customers, served by the same warehouse container. The app
# looks at the host name and shows only the shop here — none of the warehouse
# system is reachable on this address. Its own certificate, issued on the
# first request once the DNS record exists (grey cloud, like the main domain).
shop.nefwarehouse.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	reverse_proxy wms:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}

	# Product photos are uploaded on the warehouse side; nothing large comes in here.
	request_body {
		max_size 2MB
	}
}
